# This application uses OpenRouter only. Never use NEXT_PUBLIC_ for credentials.
# POLZA_API_KEY is ignored and blocked in this application.
OPENROUTER_API_KEY=

# Optional overrides; existing Desktop installations are discovered on this Mac.
# ECGFOUNDER_HOME=/absolute/path/to/ECG-opus
# ECGFOUNDER_PYTHON=/absolute/path/to/ECG-opus/.venv/bin/python
# ECGFOUNDER_WEIGHTS=/absolute/path/to/12_lead_ECGFounder.pth
# RADIOLOGY_SOURCE_HOME=/absolute/path/to/opus-radiology-ai-github
# PROTOCOL_RU_SOURCE_HOME=/absolute/path/to/original/russian/protocol-app
# PROTOCOL_EN_SOURCE_HOME=/absolute/path/to/original/english/protocol-app
# Optional for original Global audio-file transcription (browser dictation is separate):
# ASSEMBLYAI_API_KEY=

# Optional path to the original standalone medical translator. Credentials stay in its .env.local.
# TRANSLATOR_SOURCE_HOME=/path/to/medical-translator
