new file mode 100644
index 0000000..ab55ec4
--- /dev/null
+++ b/lib/phone-receive.ts
@@ -0,0 +1,16 @@
+export async function receiveNextPhoneFile(token: string, since: number, signal: AbortSignal) {
+  const response = await fetch('/api/phone/next', {
+    method: 'POST', cache: 'no-store', signal,
+    headers: {'content-type': 'application/json'},
+    body: JSON.stringify({token, since}),
+  });
+  if (response.status === 404) throw new Error('phone_session_expired');
+  if (response.status === 204) return null;
+  if (!response.ok) throw new Error('phone_receive_failed');
+  const id = Number(response.headers.get('x-phone-id'));
+  if (!Number.isSafeInteger(id) || id <= since) throw new Error('phone_receive_failed');
+  const name = decodeURIComponent(response.headers.get('x-phone-name') ?? '');
+  const blob = await response.blob();
+  if (!name || !blob.size) throw new Error('phone_receive_failed');
+  return {id, file: new File([blob], name, {type: decodeURIComponent(response.headers.get('x-phone-type') ?? '')})};
+}
