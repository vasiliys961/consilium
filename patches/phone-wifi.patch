+'use client';
+import {useEffect} from 'react';
+import {receiveInboxFile} from '@/lib/file-inbox';
+import {receiveNextPhoneFile} from '@/lib/phone-receive';
+
+export const inboxSessionKey = 'concilium-phone-inbox-session';
+export const inboxUpdate = 'concilium-phone-inbox-update';
+export const inboxWake = 'concilium-phone-inbox-wake';
+
+// Lives in the unlocked app shell, so navigation does not detach the scanner inbox.
+export function PhoneInboxReceiver() {
+  useEffect(() => {
+    if (location.pathname.startsWith('/phone/')) return;
+    const controller = new AbortController();
+    let running = false;
+    async function poll() {
+      if (running || controller.signal.aborted) return;
+      running = true;
+      let token = '';
+      function notify(message: string, expired = false) {
+        window.dispatchEvent(new CustomEvent(inboxUpdate, {detail: {message, expired, token}}));
+      }
+      try {
+        const raw = sessionStorage.getItem(inboxSessionKey);
+        if (!raw) return;
+        token = JSON.parse(raw).token;
+        if (!token) return;
+        const cursor = 'concilium-phone-since:' + token;
+        let since = Number(sessionStorage.getItem(cursor)) || 0;
+        while (!controller.signal.aborted) {
+          const next = await receiveNextPhoneFile(token, since, controller.signal);
+          if (!next || controller.signal.aborted) break;
+          try {
+            await receiveInboxFile(next.file);
+          } catch {
+            notify('На Mac не удалось сохранить файл в папку приёма. Файл остаётся в очереди.');
+            break;
+          }
+          since = next.id;
+          sessionStorage.setItem(cursor, String(since));
+          notify('Файл с телефона сохранён в папке приёма.');
+        }
+      } catch (error) {
+        if (controller.signal.aborted) return;
+        const expired = error instanceof Error && error.message === 'phone_session_expired';
+        if (expired && JSON.parse(sessionStorage.getItem(inboxSessionKey) || '{}').token === token)
+          sessionStorage.removeItem(inboxSessionKey);
+        notify(expired ? 'Сессия истекла. Откройте новый QR-код.' : 'Mac ожидает ответа сервера передачи.', expired);
+      } finally {
+        running = false;
+      }
+    }
+    const resume = () => void poll();
+    resume();
+    const timer = setInterval(resume, 2500);
+    window.addEventListener(inboxWake, resume);
+    window.addEventListener('online', resume);
+    return () => {
+      controller.abort();
+      clearInterval(timer);
+      window.removeEventListener(inboxWake, resume);
+      window.removeEventListener('online', resume);
+    };
+  }, []);
+  return null;
+}
