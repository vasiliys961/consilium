@@ -0,0 +1,20 @@
+import {phoneFilesSince} from '@/packages/phone/bridge';
+
+export const runtime = 'nodejs';
+
+// Desktop only. The phone relay deliberately does not expose this endpoint.
+export async function POST(request: Request) {
+  const body = await request.json().catch(() => null);
+  if (typeof body?.token !== 'string' || !Number.isSafeInteger(body.since) || body.since < 0)
+    return new Response(null, {status: 400});
+  const files = phoneFilesSince(body.token, body.since);
+  const headers = new Headers({'cache-control': 'no-store'});
+  if (!files?.length) return new Response(null, {status: files ? 204 : 404, headers});
+  const file = files[0];
+  headers.set('content-type', 'application/octet-stream');
+  headers.set('x-content-type-options', 'nosniff');
+  headers.set('x-phone-type', encodeURIComponent(file.mimeType));
+  headers.set('x-phone-name', encodeURIComponent(file.name));
+  headers.set('x-phone-id', String(file.id));
+  return new Response(new Uint8Array(file.bytes), {headers});
+}
