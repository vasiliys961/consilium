{
  "name": "doctor-opus-next",
  "private": true,
  "scripts": {
    "test": "node --experimental-strip-types --test lib/*.test.ts packages/*/*.test.ts",
    "dev": "node --require ./scripts/openrouter-only.cjs node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3107",
    "dev:preview": "node scripts/preview-preflight.mjs && NEXT_PUBLIC_CONCILIUM_PREVIEW=1 node --require ./scripts/openrouter-only.cjs node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3207",
    "build": "node --require ./scripts/openrouter-only.cjs node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/openrouter-only.cjs node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3107",
    "typecheck": "tsc --noEmit",
    "logs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/watch-logs.ts",
    "setup:library-models": "node scripts/setup-library-models.mjs",
    "setup:protocols": "node scripts/ensure-native-protocols.mjs",
    "check:preview": "node scripts/preview-preflight.mjs",
    "update:preview": "node scripts/update-preview.mjs",
    "setup:radiology:preview": "node scripts/setup-radiology-preview.mjs",
    "approve:radiology:preview": "node scripts/approve-radiology-preview.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@xenova/transformers": "^2.17.2",
    "jpeg-js": "^0.4.4",
    "next": "^14.2.15",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^20.16.10",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
